rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (default deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isUserAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'qdezimoveis@gmail.com' ||
        isUserAdmin()
      );
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isSignedIn() && isUserAdmin();
    }

    // --- Inspections (Vistorias) ---
    match /inspections/{inspectionId} {
      allow read: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.createdBy == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isUserAdmin();

      // Subcollection: Rooms (Ambientes)
      match /rooms/{roomId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/inspections/$(inspectionId)).data.createdBy == request.auth.uid || isAdmin());
        allow create: if isSignedIn() && (get(/databases/$(database)/documents/inspections/$(inspectionId)).data.createdBy == request.auth.uid || isAdmin());
        allow update: if isSignedIn() && (get(/databases/$(database)/documents/inspections/$(inspectionId)).data.createdBy == request.auth.uid || isAdmin());
        allow delete: if isSignedIn() && isUserAdmin();

        // Subcollection: Items (Itens do Ambiente)
        match /items/{itemId} {
          allow read: if isSignedIn() && (get(/databases/$(database)/documents/inspections/$(inspectionId)).data.createdBy == request.auth.uid || isAdmin());
          allow create: if isSignedIn() && (get(/databases/$(database)/documents/inspections/$(inspectionId)).data.createdBy == request.auth.uid || isAdmin());
          allow update: if isSignedIn() && (get(/databases/$(database)/documents/inspections/$(inspectionId)).data.createdBy == request.auth.uid || isAdmin());
          allow delete: if isSignedIn() && isUserAdmin();
        }
      }
    }

    // --- Appraisals (Pareceres de Comercialização) ---
    match /appraisals/{appraisalId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isUserAdmin();
    }

    // --- Catalog Collections ---
    match /owners/{ownerId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && isUserAdmin();
    }

    match /tenants/{tenantId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && isUserAdmin();
    }

    match /properties/{propertyId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && isUserAdmin();
    }

    // --- Media Attachments ---
    match /mediaAttachments/{attachmentId} {
      allow read: if isSignedIn() && (
        resource.data.inspectionId == null || 
        get(/databases/$(database)/documents/inspections/$(resource.data.inspectionId)).data.createdBy == request.auth.uid || 
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.inspectionId == null || 
        get(/databases/$(database)/documents/inspections/$(request.resource.data.inspectionId)).data.createdBy == request.auth.uid || 
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.inspectionId == null || 
        get(/databases/$(database)/documents/inspections/$(resource.data.inspectionId)).data.createdBy == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isSignedIn() && isUserAdmin();
    }
  }
}
